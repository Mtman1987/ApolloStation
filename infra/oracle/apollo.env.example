# Copy to infra/oracle/apollo.env and replace every REPLACE_* value.
# Never commit the populated apollo.env file.

# OCI block-volume mount points (prepare both with their host preflight scripts).
APOLLO_DATA_HOST_PATH=/mnt/apollo-data
RESTREAM_PROFILE_HOST_PATH=/mnt/apollo-restream-profile

# TLS identity for the private Restream hostname. The certificate SAN must match RESTREAM_PRIVATE_HOST.
RESTREAM_TLS_CERT_HOST_PATH=/etc/apollo/tls/restream-control.crt
RESTREAM_TLS_KEY_HOST_PATH=/etc/apollo/tls/restream-control.key

# Public DNS names. Point each public name to the Oracle VM; Restream is additionally IP-restricted by Caddy.
SPMT_PUBLIC_HOST=spmt.example.com
SPMT_API_HOST=api.spmt.example.com
NEBULA_PUBLIC_HOST=nebula.example.com
STREAMWEAVER_PUBLIC_HOST=streamweaver.example.com
DSH_PUBLIC_HOST=discord.example.com
HEARMEOUT_PUBLIC_HOST=hearmeout.example.com
RESTREAM_PRIVATE_HOST=restream-internal.example.com

# Canonical SPMT keys: each must be a base64url encoding of exactly 32 random bytes.
SPMT_WEBHOOK_KEY=REPLACE_WITH_43_CHAR_BASE64URL_KEY
SPMT_PROVIDER_CREDENTIAL_KEY=REPLACE_WITH_43_CHAR_BASE64URL_KEY

# Generate each service credential independently with: openssl rand -hex 32
CHAT_GATEWAY_WORKER_CREDENTIAL=REPLACE_WITH_64_HEX_CHARS
STREAMWEAVER_WORKER_CREDENTIAL=REPLACE_WITH_64_HEX_CHARS
DSH_WORKER_CREDENTIAL=REPLACE_WITH_64_HEX_CHARS
DSH_SERVICE_SECRET=REPLACE_WITH_64_HEX_CHARS
NEBULA_ARCADE_WORKER_CREDENTIAL=REPLACE_WITH_64_HEX_CHARS
STELLAR_WORKER_CREDENTIAL=REPLACE_WITH_64_HEX_CHARS
HEARMEOUT_WORKER_CREDENTIAL=REPLACE_WITH_64_HEX_CHARS
RESTREAM_CONTROL_CREDENTIAL=REPLACE_WITH_64_HEX_CHARS

# Runtime mode and provider settings.
SPMT_RUNTIME_MODE=production
SPMT_OUTBOUND_MODE=active
SPMT_STELLAR_CHAT_ENABLED=1
SPMT_SPEECH_ENABLED=1
SPMT_SPEECH_OUTBOUND_ENABLED=1
SPMT_CHAT_GATEWAY_ENABLED=1
SPMT_STREAMWEAVER_PROVIDER_RUNTIME_ENABLED=1
SPMT_DSH_LIVE_RUNTIME_ENABLED=1
SPMT_NEBULA_ARCADE_PROVIDER_RUNTIME_ENABLED=1
SPMT_HEARMEOUT_RUNTIME_ENABLED=1
STELLAR_EXECUTION_TARGET=hosted
STELLAR_PROVIDER_ORIGIN=https://YOUR_OPENAI_COMPATIBLE_PROVIDER
STELLAR_PROVIDER_MODEL=REPLACE_WITH_MODEL_ID
OPENAI_API_KEY=
STELLAR_KOKORO_URL=http://kokoro:8080
STELLAR_KOKORO_AUTH_TOKEN=REPLACE_WITH_64_HEX_CHARS

# OAuth/provider credentials; fill only providers actually used.
TWITCH_CLIENT_ID=REPLACE_ME
TWITCH_CLIENT_SECRET=REPLACE_ME
TWITCH_BOT_OAUTH_TOKEN=
SPMT_TWITCH_BOT_ROLES=
DISCORD_CLIENT_ID=REPLACE_ME
DISCORD_CLIENT_SECRET=REPLACE_ME
DISCORD_BOT_TOKEN=REPLACE_ME
DISCORD_PUBLIC_KEY=REPLACE_ME
DSH_DISCORD_PUBLIC_KEY=REPLACE_ME
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Provider connection list must be replaced with the actual tenant-scoped JSON configuration.
CHAT_GATEWAY_CONNECTIONS=[{"schemaVersion":1,"tenantId":"REPLACE_WITH_TENANT_ID","provider":"twitch","connectionId":"nebula-twitch","channelId":"REPLACE_WITH_TWITCH_LOGIN","providerAccountId":"REPLACE_WITH_LINKED_TWITCH_BOT_ACCOUNT_ID","desired":true},{"schemaVersion":1,"tenantId":"REPLACE_WITH_TENANT_ID","provider":"discord","connectionId":"nebula-support","channelId":"REPLACE_WITH_SUPPORT_CHANNEL_ID","providerAccountId":"REPLACE_WITH_LINKED_DISCORD_BOT_ACCOUNT_ID","desired":true},{"schemaVersion":1,"tenantId":"REPLACE_WITH_TENANT_ID","provider":"discord","connectionId":"nebula-packs","channelId":"REPLACE_WITH_PACK_CHANNEL_ID","providerAccountId":"REPLACE_WITH_LINKED_DISCORD_BOT_ACCOUNT_ID","desired":true}]

# Production runtime configuration files must exist on the mounted data volume under config/.
NEBULA_ARCADE_TENANT_ID=REPLACE_WITH_TENANT_ID
NEBULA_ARCADE_CHANNEL_ID=REPLACE_WITH_CHANNEL_ID
NEBULA_ARCADE_WEBHOOK_NAME=Nebula Arcade
HEARMEOUT_ACTIVITY_TENANT_ID=REPLACE_WITH_TENANT_ID
HEARMEOUT_BROADCAST_EXECUTION_USER_ID=REPLACE_WITH_EXECUTION_USER_ID

# Lounge worker runs separately from the new Restream receiver.
HMO_LOUNGE_DIRECT_ONLY=true
RESTREAM_AUTOMATION_ENABLED=false
