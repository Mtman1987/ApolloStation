# Copy to terraform.tfvars locally. Never commit real credentials or private keys.
tenancy_ocid       = "ocid1.tenancy.oc1..REPLACE"
user_ocid          = "ocid1.user.oc1..REPLACE"
fingerprint        = "REPLACE"
private_key_path   = "~/.oci/apollo_api_key.pem"
region             = "us-ashburn-1"
compartment_ocid   = "ocid1.compartment.oc1..REPLACE"
image_ocid         = "ocid1.image.oc1..REPLACE_WITH_UBUNTU_ARM64_IMAGE"
ssh_public_key     = "ssh-ed25519 REPLACE"
admin_cidr         = "REPLACE_WITH_YOUR_PUBLIC_IP/32"
