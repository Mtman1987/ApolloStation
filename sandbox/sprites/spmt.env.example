# Documentation only. Do not rename this file to .env or place credentials in it.
SPMT_RUNTIME_MODE=sandbox
SPMT_OUTBOUND_MODE=disabled
SPMT_SANDBOX_ID=spmt-ecosystem-sandbox
SPMT_SANDBOX_FIXTURES=1
DATABASE_PATH=/home/sprite/data/spmt-green-sandbox.sqlite
SPMT_PUBLIC_URL=https://REPLACE-WITH-PRIVATE-SPRITE-URL.sprites.app
SPMT_HOST=127.0.0.1
SPMT_ORIGIN=http://127.0.0.1:3000

# SPMT_WEBHOOK_KEY is generated in memory by run-supervised-sandbox.mjs.
# Discord, Twitch, Kick, LiveKit, Fly, Firebase, and Sprites tokens are forbidden.
