+test('manual evidence names are upload-safe and unique without losing app provenance', () => {
+  const workflow = read('.github/workflows/apollo-donor-inventory.yml');
+  const section = workflow.slice(workflow.indexOf('- name: Upload complete parity evidence bundle'));
+  const template = section.match(/^\s+name: (.+)$/m)?.[1];
+  assert.equal(template, 'parity-evidence-${{ inputs.donor }}-${{ github.run_id }}');
+  const names = new Set();
+  for (const donor of ['hearmeout', 'streamweaver', 'discord-stream-hub']) {
+    for (const runId of ['41706393191', '41706393224']) {
+      const name = template.replace('${{ inputs.donor }}', donor).replace('${{ github.run_id }}', runId);
+      assert.doesNotMatch(name, /["<>|:*?\\/\r\n]/, 'artifact name contains a forbidden character');
+      assert.equal(names.has(name), false, 'separate dispatches must not collide');
+      names.add(name);
+    }
+  }
+  assert.ok(workflow.includes('APOLLO_APP: ${{ inputs.apollo_app }}'));
+  assert.ok(workflow.includes('--ref "$GITHUB_SHA:$APOLLO_APP" --app-path "$APOLLO_APP"'));
+  assert.ok(workflow.includes('export DONOR_COMMIT_SHA="$(git rev-parse HEAD)"'));
+});
