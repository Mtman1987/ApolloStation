# Copy outside the repository and replace every placeholder. Never commit credentials.
SPMT_RUNTIME_MODE=production
SPMT_ORIGIN=http://127.0.0.1:3000
SPMT_PUBLIC_ORIGIN=https://replace-with-public-host.example
NEBULA_ARCADE_PUBLIC_ORIGIN=https://replace-with-public-host.example
NEBULA_ARCADE_ORIGIN=http://127.0.0.1:3100
NEBULA_ARCADE_TENANT_ID=replace-with-spmt-tenant-id
NEBULA_ARCADE_CHANNEL_ID=streamer_login
NEBULA_ARCADE_DATABASE_PATH=/srv/apollo/data/nebula.sqlite
NEBULA_ARCADE_RUNTIME_CONFIG_PATH=/srv/apollo/config/nebula-runtime.json
NEBULA_ARCADE_PROVIDER_RUNTIME_ENABLED=1
SPMT_NEBULA_ARCADE_PROVIDER_RUNTIME_ENABLED=1
NEBULA_ARCADE_WORKER_CREDENTIAL=replace-with-unique-service-credential
SPMT_CHAT_GATEWAY_ENABLED=1
CHAT_GATEWAY_WORKER_CREDENTIAL=replace-with-another-service-credential
CHAT_GATEWAY_DATABASE_PATH=/srv/apollo/data/chat-gateway.sqlite
CHAT_GATEWAY_CONNECTIONS=[{"schemaVersion":1,"tenantId":"replace-with-spmt-tenant-id","provider":"twitch","connectionId":"nebula-twitch","channelId":"streamer_login","providerAccountId":"replace-with-linked-bot-account-id","desired":true}]
# Add matching Discord support/pack connections before production preflight.
# Keep supportChannelId pointed at a private administrator channel.
# Set these in the DSH services, which share one DSH database:
# SPMT_DSH_LIVE_RUNTIME_ENABLED=1
# DSH_WORKER_CREDENTIAL=<DSH service credential>
# DSH_DATABASE_PATH=/srv/apollo/data/dsh.sqlite
# DSH_RUNTIME_CONFIG_PATH=/srv/apollo/config/dsh-runtime.json
# DSH_MEDIA_SOURCE_ORIGINS=https://your-nebula-host,https://your-image-provider-cdn
# Image generation uses the existing StreamWeaver image worker and SeaArt configuration.
# Themed Bingo uses the existing Stellar Core chat worker. Manual boards work without AI.
